# @defaultSensitive=inferFromPrefix(PUBLIC_)
# @defaultRequired=infer
# @generateTypes(lang=ts, path=src/lib/convex/convex-env.d.ts)
# @redactLogs=true
# @preventLeaks=true
# ---

# ====================================
# Better Auth
# ====================================

# Secret for signing sessions and tokens
# @required @sensitive
BETTER_AUTH_SECRET=

# Base URL for OAuth redirects and deep links
# @type=url @required
SITE_URL=

# ====================================
# Email System (Resend)
# ====================================

# Resend API key for transactional email delivery
# @required @sensitive
RESEND_API_KEY=

# Sender email address for auth emails
# @required
AUTH_EMAIL=

# Production URL for email assets (logo images, footer links)
# Must always be a public domain (email clients cannot access localhost)
# @type=url @required
EMAIL_ASSET_URL=

# Resend webhook signing secret
# @optional @sensitive
RESEND_WEBHOOK_SECRET=

# Le domaine neutre des relances (suivi-factures.fr), vérifié chez Resend. Posé, chaque
# établissement relance depuis SON adresse, tirée de son nom (durand-btp@suivi-factures.fr),
# les réponses chez le gérant. Absent, l'adresse commune ci-dessous. Voir serveurs/resend/LISEZMOI.md.
# @optional
RELANCES_DOMAINE=

# L'adresse commune des relances quand aucun domaine neutre n'est posé ; à défaut, AUTH_EMAIL.
# @optional
RELANCES_EMAIL=

# ====================================
# Paddle Billing
# ====================================
# Le pas à pas (bac à sable, puis compte live) : serveurs/paddle/LISEZMOI.md.
# Toutes facultatives : sans elles, rien n'est encaissé et tout reste ouvert.

# Clé d'API côté serveur (portail client, catalogue). Son préfixe dit
# l'environnement : pdl_sdbx_ pour le bac à sable, pdl_live_ pour le compte live.
# Get from: Paddle Dashboard → Developer Tools → Authentication
# @optional @sensitive
PADDLE_API_KEY=

# Jeton côté client, que Paddle.js utilise dans le navigateur : test_ pour le
# bac à sable, live_ pour le compte live. Public par nature, mais posé ici et
# servi par le serveur, pour qu'un seul déploiement dise un seul environnement.
# Get from: Paddle Dashboard → Developer Tools → Authentication → Client-side tokens
# @optional
PADDLE_CLIENT_TOKEN=

# « sandbox » ou « production ». Facultatif : l'environnement se lit sur le
# préfixe de la clé ; posé, il doit la confirmer, sinon la caisse le dit.
# @optional
PADDLE_ENVIRONMENT=

# Secret de la destination de notification (vérifie la signature des rappels,
# et scelle l'établissement dans chaque paiement). Il ne se relit qu'une fois,
# à la création de la destination.
# Get from: Paddle Dashboard → Developer Tools → Notifications
# @optional @sensitive
PADDLE_WEBHOOK_SECRET=

# « oui » ouvre la facturation : l'essai fini sans abonnement ferme alors les
# invitations, et les boutons de paiement apparaissent. À poser quand le
# paiement fonctionne vraiment, jamais avec la clé : voir `paiementOuvert`
# dans src/lib/convex/billing.ts.
# @optional
PADDLE_FACTURATION_OUVERTE=

# Les identifiants de prix ne se posent pas ici : le catalogue les crée d'après
# la grille et les range dans la table prixPaddle
# (npx convex run paddleCatalogue:catalogue '{"creer":true}').

# ====================================
# Claude — extraction et classification
# ====================================

# Cle API Anthropic, lue par le SDK depuis l'environnement.
#
# ELLE EST LA SEULE VARIABLE SANS LAQUELLE LE PRODUIT NE FAIT RIEN : ni lecture
# de facture, ni classification. Le schema exigeait jusqu ici OPENROUTER_API_KEY,
# heritee d un chat de support qui n existe plus, et ne mentionnait pas celle-ci.
# Le deploiement reclamait donc une cle que rien n utilise, et laissait passer
# l absence de celle dont tout depend : un deploiement reussi aurait echoue a la
# premiere facture.
# @required @sensitive
ANTHROPIC_API_KEY=

# ====================================
# OAuth Providers
# ====================================

# Google OAuth
# @optional
AUTH_GOOGLE_ID=

# @optional @sensitive
AUTH_GOOGLE_SECRET=

# GitHub OAuth
# @optional
AUTH_GITHUB_ID=

# @optional @sensitive
AUTH_GITHUB_SECRET=

# ====================================
# E2E Testing
# ====================================

# Secret for test mutations (never set in production)
# @optional @sensitive
AUTH_E2E_TEST_SECRET=

# ====================================
# Preview Dev (auto-seeded on preview deployments)
# ====================================

# Password for the auto-seeded preview admin (admin@preview.dev)
# Only set on preview Convex deployments by deploy.ts
# @optional @sensitive
PREVIEW_ADMIN_PASSWORD=

# ====================================
# Local Dev (auto-generated by vite.config.ts)
# ====================================

# Flag indicating local Convex dev mode
# @type=boolean @optional
LOCAL_CONVEX_DEV=

# Seeded admin credentials for local dev
# @optional
LOCAL_SEEDED_ADMIN_EMAIL=

# @optional @sensitive
LOCAL_SEEDED_ADMIN_PASSWORD=

# @optional
LOCAL_SEEDED_ADMIN_NAME=

# ====================================
# Connexion Qonto — lecture seule des factures clients
# ====================================
# Identifiants de l'application Letikette sur https://developers.qonto.com.
# Absents : la carte « Connecter Qonto » ne s'affiche pas, rien ne casse.
# @optional @sensitive
QONTO_CLIENT_ID=
# @optional @sensitive
QONTO_CLIENT_SECRET=
# « sandbox » pour le bac à sable ; absent ou « production » sinon.
# @optional
QONTO_ENVIRONNEMENT=
# Jeton du bac à sable, pris sur le portail développeur. Inutile en production.
# @optional @sensitive
QONTO_STAGING_TOKEN=
# Clé AES-256 en base64 qui chiffre les jetons des connexions : openssl rand -base64 32
# @optional @sensitive
CONNEXIONS_CLE_CHIFFREMENT=

# Clé maîtresse du coffre des documents (AES-256, base64) : openssl rand -base64 32.
# Elle enveloppe la clé de chaque établissement ; sans elle, aucun document ne se
# scelle ni ne s ouvre. La perdre rend tous les documents illisibles : la garder
# aussi dans un gestionnaire de mots de passe. Voir src/lib/convex/coffre/serrure.ts.
# @optional @sensitive
COFFRE_CLE_MAITRESSE=

# ====================================
# Service client (Aide) — docs/superpowers/specs/2026-10-16-service-client.md
# ====================================
# Toutes facultatives : sans elles, l'Aide fonctionne, et toute question va à l'équipe.

# « oui » ouvre Plume support (les réponses automatiques de l'Aide). À poser
# trente jours après le préavis de la politique de confidentialité 2.8.
# @optional
PLUME_SUPPORT_OUVERT=

# Secret du webhook « email.received » de Resend (réception des e-mails).
# Posé AVANT de créer le webhook. Get from: Resend → Webhooks.
# @optional @sensitive
RESEND_RECEPTION_WEBHOOK_SECRET=

# Le domaine qui reçoit (aide.letikette.com), et d'où se répondent les fils.
# La réception reste fermée tant que les relances partent du domaine d’AUTH_EMAIL (ou d’un sous-domaine).
# @optional
SUPPORT_RECEPTION_DOMAINE=
