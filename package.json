{
	"name": "saas-starter",
	"version": "0.1.0",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "bun scripts/dev.ts",
		"dev:frontend": "bun scripts/dev.ts",
		"dev:cloud": "bun-tasks dev:frontend ::: dev:backend:cloud",
		"dev:backend:cloud": "convex dev",
		"dev:test": "VARLOCK_ENV=test bun scripts/dev-test.ts",
		"generate": "bun scripts/generate-convex.ts",
		"postinstall": "varlock typegen && varlock typegen --path .env-convex.schema",
		"build": "vite build",
		"preview": "vite preview",
		"check": "tsc --noEmit",
		"check:convex": "tsc -p src/lib/convex/tsconfig.json --noEmit",
		"format": "prettier --write .",
		"lint": "eslint . --cache --concurrency auto && oxlint",
		"lint:convex": "oxlint",
		"knip": "knip",
		"static-checks": "bun scripts/static-checks.ts",
		"test:unit": "vitest --run --reporter=dot --passWithNoTests",
		"test:e2e": "VARLOCK_ENV=test playwright test",
		"test": "bun run test:unit",
		"model:eval": "bun scripts/model-eval.ts",
		"prepare": "husky",
		"check:bundle": "bun scripts/verifier-bundle-convex.ts",
		"check:vercel": "bun scripts/verifier-entree-vercel.ts"
	},
	"packageManager": "bun@1.3.9",
	"dependencies": {
		"@anthropic-ai/sdk": "^0.117.1",
		"@better-auth/passkey": "~1.6.9",
		"@cladd-ui/react": "0.18.5",
		"@convex-dev/agent": "^0.6.1",
		"@convex-dev/better-auth": "^0.12.5",
		"@convex-dev/rate-limiter": "^0.3.2",
		"@convex-dev/resend": "^0.2.0",
		"@fontsource-variable/plus-jakarta-sans": "^5.3.0",
		"@gilhrpenner/convex-files-control": "^0.5.1",
		"@jsquash/webp": "^1.5.0",
		"@openrouter/ai-sdk-provider": "^2.9.0",
		"@tanstack/react-router": "^1.170.31",
		"@tanstack/react-start": "^1.168.48",
		"@types/papaparse": "^5.5.2",
		"@varlock/vite-integration": "^1.1.0",
		"@zxcvbn-ts/core": "^3.0.4",
		"@zxcvbn-ts/language-common": "^3.0.4",
		"@zxcvbn-ts/language-en": "^3.0.2",
		"ai": "^6.0.174",
		"better-auth": "~1.6.9",
		"convex-helpers": "^0.1.108",
		"date-fns": "^4.1.0",
		"exceljs": "^4.4.0",
		"isomorphic-dompurify": "^3.0.0",
		"jspdf": "^4.2.1",
		"jspdf-autotable": "^5.0.8",
		"lucide-react": "^1.33.0",
		"papaparse": "^5.5.3",
		"posthog-js": "^1.290.0",
		"react": "^19",
		"react-day-picker": "^10.0.1",
		"react-dom": "^19",
		"resend": "^6.5.2",
		"sonner": "^2.0.8",
		"unpdf": "^1.8.1",
		"valibot": "^1.2.0",
		"varlock": "^1.1.0",
		"web-haptics": "^0.0.6",
		"zod": "^4.4.2"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.11.3",
		"@convex-dev/eslint-plugin": "2.0.0",
		"@eslint/compat": "2.1.0",
		"@eslint/js": "10.0.1",
		"@fontsource-variable/outfit": "5.2.8",
		"@internationalized/date": "3.12.1",
		"@oxlint/plugins": "1.62.0",
		"@playwright/test": "1.59.1",
		"@resvg/resvg-js": "2.6.2",
		"@tailwindcss/forms": "0.5.11",
		"@tailwindcss/typography": "0.5.19",
		"@tailwindcss/vite": "4.2.4",
		"@tanstack/table-core": "8.21.3",
		"@types/node": "25.6.0",
		"@types/pdfmake": "^0.3.3",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@typescript-eslint/eslint-plugin": "8.59.1",
		"@typescript-eslint/parser": "8.59.1",
		"@vitejs/plugin-react": "^5.0.0",
		"bun-tasks": "0.1.2",
		"clsx": "2.1.1",
		"convex": "1.37.0",
		"convex-test": "0.0.54",
		"convex-vite-plugin": "0.4.0",
		"eslint": "10.4.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-react-hooks": "^7.0.0",
		"globals": "17.6.0",
		"husky": "9.1.7",
		"jose": "6.2.3",
		"jsdom": "29.1.1",
		"knip": "6.11.0",
		"oxlint": "1.62.0",
		"oxlint-plugin-convex": "0.1.1",
		"prettier": "3.8.3",
		"prettier-plugin-tailwindcss": "0.8.0",
		"rollup-plugin-visualizer": "7.0.1",
		"tailwind-merge": "3.5.0",
		"tailwind-variants": "3.2.2",
		"tailwindcss": "4.2.4",
		"tsx": "4.21.0",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.59.1",
		"vaul-svelte": "1.0.0-next.7",
		"vercel": "53.1.1",
		"vite": "8.0.10",
		"vitest": "4.1.5"
	},
	"patchedDependencies": {
		"oxlint-plugin-convex@0.1.1": "patches/oxlint-plugin-convex@0.1.1.patch"
	},
	"overrides": {
		"zod": "$zod",
		"@peculiar/asn1-schema": "^2.7.0"
	}
}
