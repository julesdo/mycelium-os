{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"types": ["vite/client", "node"],

		"allowJs": true,
		"checkJs": false,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": false,
		"noEmit": true,

		"strict": true,
		"noUncheckedIndexedAccess": true
	},
	"include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", "scripts/**/*.ts"],
	"exclude": [
		"node_modules/**",
		"references/**",
		"e2e/**",
		".output/**",
		".tanstack/**",
		"src/lib/convex/**"
	]
}
